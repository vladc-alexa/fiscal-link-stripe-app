# Stripe App — developer credentials (never commit this file)
# STRIPE_APP_SECRET is generated by `stripe apps upload` (App settings → App secret).

# App secret used to verify signed requests from the UI extension (from `stripe apps upload`).
STRIPE_APP_SECRET=

# Your Stripe developer key (sk_...) for the OAuth token exchange and Secret Store API.
# Live-mode key for live installs; test-mode key for test installs.
STRIPE_SECRET_KEY=

# Public HTTPS base URL of this app backend (the manifest allowed_redirect_uris must match).
APP_URL=https://stripe-app.autoanaf.ro

# FiscalLink core API base (public endpoint).
FISCALLINK_CORE_URL=https://core.autoanaf.ro

# Port for the Express server.
PORT=3001
